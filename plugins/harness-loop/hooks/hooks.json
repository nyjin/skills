{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{"type": "command", "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"", "timeout": 5}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"", "timeout": 5}]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [{"type": "command", "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"", "timeout": 5}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Bash",
        "hooks": [{"type": "command", "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"", "timeout": 5}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{"type": "command", "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"", "timeout": 5}]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [{"type": "command", "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"", "timeout": 5}]
      }
    ]
  }
}
